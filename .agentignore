# agentignore input policy for Codex and Claude Code.
# Sensitive defaults are always added by the compiler.
# Basename patterns match at any depth. /path anchors at the project root.
# Directories end with /. Only *, ? and ** are supported. No ! exceptions.
# Add optional artifact exclusions deliberately; .gitignore is not auto-imported.
__pycache__/
.pytest_cache/
*.egg-info/
